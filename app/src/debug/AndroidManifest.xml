<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: allow unencrypted ws:// so the TV can reach the local mock
    subtitle server on the LAN. Release builds keep Android's default (wss:// only).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
