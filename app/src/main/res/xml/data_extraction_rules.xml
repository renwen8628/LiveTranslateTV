<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Remote Play pairing keys stay on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="remote_play.xml" />
        <exclude domain="sharedpref" path="subtitle_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="remote_play.xml" />
        <exclude domain="sharedpref" path="subtitle_settings.xml" />
    </device-transfer>
</data-extraction-rules>
